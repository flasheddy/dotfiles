  },
  "link_text": {
    "color": "#89b4fa",
    "bold": true
  },
  "code": {
    "color": "#fab387",
    "background_color": "#313244"
  },
  "code_block": {
    "margin": 1,
    "chroma": {
      "text": {
        "color": "#cdd6f4"
      },
      "background": {
        "color": "#313244"
      },
      "comment": {
        "color": "#6c7086",
        "italic": true
      },
      "keyword": {
        "color": "#cba6f7",
        "bold": true
      },
      "keyword_reserved": {
        "color": "#f38ba8"
      },
      "name": {
        "color": "#89b4fa"
      },
      "name_function": {
        "color": "#89b4fa"
      },
      "name_class": {
        "color": "#f9e2af",
        "bold": true
      },
      "name_tag": {
        "color": "#f38ba8"
      },
      "name_attribute": {
        "color": "#f9e2af"
      },
      "literal": {
        "color": "#fab387"
      },
      "literal_string": {
        "color": "#a6e3a1"
      },
      "literal_number": {
        "color": "#fab387"
      },
      "operator": {
        "color": "#89dceb"
      },
      "punctuation": {
        "color": "#9399b2"
      },
      "generic_heading": {
        "color": "#cba6f7",
        "bold": true
      },
      "generic_deleted": {
        "color": "#f38ba8"
      },
      "generic_inserted": {
        "color": "#a6e3a1"
      },
      "generic_emph": {
        "color": "#b4befe",
        "italic": true
      },
      "generic_strong": {
        "color": "#cba6f7",
        "bold": true
      }
    }
  },
  "block_quote": {
    "block_prefix": "│ ",
    "block_suffix": "",
    "indent": 1,
    "color": "#a6adc8",
    "border": {
      "color": "#cba6f7"
    }
  },
  "table": {
    "color": "#cdd6f4",
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "table_header": {
    "color": "#b4befe",
    "bold": true
  },
  "hr": {
    "color": "#585b70",
    "format": "────"
  },
  "strikethrough": {
    "color": "#a6adc8",
    "strikethrough": true
  },
  "checkbox": {
    "checked": "[✓]",
    "unchecked": "[ ]",
    "color": "#cba6f7"
  }
}
