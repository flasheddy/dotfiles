{
  "document": {
    "block_prefix": "",
    "block_suffix": "\n",
    "margin": 2,
    "color": "#cdd6f4"
  },
  "heading": {
    "block_prefix": "",
    "block_suffix": "\n",
    "color": "#cba6f7",
    "bold": true
  },
  "h1": {
    "color": "#cba6f7",
    "bold": true
  },
  "h2": {
    "color": "#b4befe",
    "bold": true
  },
  "h3": {
    "color": "#74c7ec",
    "bold": true
  },
  "h4": {
    "color": "#89dceb",
    "bold": true
  },
  "h5": {
    "color": "#94e2d5",
    "bold": true
  },
  "h6": {
    "color": "#94e2d5",
    "bold": true
  },
  "paragraph": {
    "color": "#cdd6f4"
  },
  "strong": {
    "color": "#cba6f7",
    "bold": true
  },
  "emph": {
    "color": "#b4befe",
    "italic": true
  },
  "item": {
    "block_prefix": "• ",
    "color": "#cdd6f4"
  },
  "enumeration": {
