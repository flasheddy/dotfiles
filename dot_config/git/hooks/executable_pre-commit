#!/usr/bin/env bash
# Global pre-commit gate: whitespace, secrets, and AGENTS.md verification.
set -euo pipefail

# Opt-in: only run in repositories carrying AGENTS.md or git-hooks/
if [ ! -f AGENTS.md ] && [ ! -d git-hooks ]; then
  exit 0
fi

# Fast exit if nothing is staged
if git diff --cached --quiet; then
  exit 0
fi

# 1. Whitespace and merge conflict markers
if ! git diff --cached --check; then
  printf '%s\n' "pre-commit: git diff --cached --check FAILED (whitespace errors or conflict markers)." >&2
  exit 1
fi

# 2. Secret scan
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --no-banner --redact --log-level warn; then
    printf '%s\n' "pre-commit: gitleaks detected staged secret material; commit blocked." >&2
    exit 1
  fi
else
  if git diff --cached --no-color -U0 | rg -n -e '-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----' \
    -e '(password|passwd|secret|api[-_]?key|access[-_]?key|client[-_]?secret|auth[-_]?token)[[:space:]]*[:=][[:space:]]*[^[:space:]]{8,}' ||
    git diff --cached --name-only | rg -i '(^|/)(id_(rsa|ed25519|ecdsa|dsa)|[^/]*\.(pem|key|ppk|p12|pfx))$'; then
    printf '%s\n' "pre-commit: potential secret material found in staged diff; commit blocked." >&2
    exit 1
  fi
fi

# 3. Documentation drift in AGENTS.md
docs_drift() {
  local file="$1" status=0 prev="" chain=0 token resolved
  [ -f "$file" ] || return 0

  while IFS= read -r token; do
    if [[ "$token" =~ ^#{2,6}[[:space:]] ]]; then
      if [[ -n "$prev" && "$chain" -lt 2 ]]; then
        if ! rg -q -x -F -- "$token" "$prev"; then
          printf 'docs-drift: %s: heading "%s" not found in %s\n' "$file" "$token" "$prev" >&2
          status=1
        fi
        chain=$((chain + 1))
      fi
      continue
    fi

    case "$token" in
      *'*'* | *'<'* | *'>'*)
        prev=""
        chain=0
        ;;
      *.md)
        resolved="${token/#\~/$HOME}"
        if [[ -e "$resolved" ]]; then
          prev="$resolved"
          chain=0
        else
          printf 'docs-drift: %s: cited path does not exist: %s\n' "$file" "$token" >&2
          status=1
          prev=""
          chain=0
        fi
        ;;
      *)
        prev=""
        chain=0
        ;;
    esac
  done < <(rg -o --no-filename '`[^`]+`' "$file" 2>/dev/null | tr -d '`' || true)

  return "$status"
}

if ! docs_drift AGENTS.md; then
  printf '%s\n' "pre-commit: documentation drift detected; commit blocked." >&2
  exit 1
fi

# 4. Floor contract freshness
floor_freshness() {
  local file="$1" declared actual
  [ -f "$file" ] || return 0

  declared="$(rg -o -r '$1' --no-filename '<!--[[:space:]]*floor-contract:[[:space:]]*sha256:([0-9a-fA-F]{64})[[:space:]]*-->' "$file" 2>/dev/null | head -n1 || true)"
  [ -n "$declared" ] || return 0

  actual="$(sha256sum "$HOME/.AGENTS.md" 2>/dev/null | cut -d' ' -f1 || true)"
  [ -n "$actual" ] || return 0

  [ "${declared,,}" = "${actual,,}" ] && return 0

  if git diff --cached --name-only | rg -q '^(AGENTS|dot_AGENTS)\.md$'; then
    printf 'floor-freshness: %s: declared floor %s, live ~/.AGENTS.md is %s\n' \
      "$file" "${declared:0:12}" "${actual:0:12}" >&2
    printf '%s\n' "floor-freshness: AGENTS.md is staged — re-affirm and run 'floor-stamp'." >&2
    return 1
  fi

  printf 'floor-freshness: advisory: %s declares floor %s, live is %s (run floor-stamp)\n' \
    "$file" "${declared:0:12}" "${actual:0:12}" >&2
  return 0
}

if ! floor_freshness AGENTS.md; then
  printf '%s\n' "pre-commit: stale global floor contract; commit blocked." >&2
  exit 1
fi
