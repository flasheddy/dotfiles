#!/usr/bin/env bash
# Global pre-commit gate: prefer the repository's `just precommit` recipe,
# fall back to generic staged whitespace and secret checks.
set -euo pipefail

# Opt-in: only run in repositories carrying AGENTS.md or git-hooks/
if [ ! -f AGENTS.md ] && [ ! -d git-hooks ]; then
  exit 0
fi

# Fast exit if nothing is staged
if git diff --cached --quiet; then
  exit 0
fi

justfile=""
for candidate in justfile Justfile .justfile; do
  if [ -f "$candidate" ]; then
    justfile="$candidate"
    break
  fi
done

if [ -n "$justfile" ]; then
  if ! command -v just >/dev/null 2>&1; then
    printf '%s\n' "pre-commit: $justfile present but 'just' is not installed; commit blocked." >&2
    exit 1
  fi
  if ! recipes="$(just --summary 2>/dev/null)"; then
    printf '%s\n' "pre-commit: $justfile could not be parsed by 'just'; commit blocked." >&2
    exit 1
  fi
  if printf '%s\n' "$recipes" | tr -s '[:space:]' '\n' | rg -qx precommit; then
    printf '%s\n' "pre-commit: running 'just precommit'..." >&2
    if ! just precommit; then
      printf '%s\n' "pre-commit: 'just precommit' FAILED; commit blocked." >&2
      exit 1
    fi
    exit 0
  fi
fi

# Fallback for repositories without a `precommit` recipe.
if ! command -v rg >/dev/null 2>&1; then
  printf '%s\n' "pre-commit: 'rg' is not installed; cannot run fallback checks." >&2
  exit 1
fi

if ! git diff --cached --check; then
  printf '%s\n' "pre-commit: git diff --cached --check FAILED (whitespace errors or conflict markers)." >&2
  exit 1
fi

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --no-banner --redact --log-level warn; then
    printf '%s\n' "pre-commit: gitleaks detected staged secret material; commit blocked." >&2
    exit 1
  fi
else
  if git diff --cached --no-color -U0 | rg -n -e '-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----' \
    -e '(password|passwd|secret|api[-_]?key|access[-_]?key|client[-_]?secret|auth[-_]?token)[[:space:]]*[:=][[:space:]]*[^[:space:]]{8,}' ||
    git diff --cached --name-only | rg -i '(^|/)(id_(rsa|ed25519|ecdsa|dsa)|[^/]*\.(pem|key|ppk|p12|pfx))$'; then
    printf '%s\n' "pre-commit: potential secret material found in staged diff; commit blocked." >&2
    exit 1
  fi
fi
