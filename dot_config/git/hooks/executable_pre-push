#!/usr/bin/env bash
# Global pre-push gate: dispatches to repository's 'just check' verification.
set -euo pipefail

# Locate justfile in repository root
justfile=""
for candidate in justfile Justfile .justfile; do
  if [ -f "$candidate" ]; then
    justfile="$candidate"
    break
  fi
done
[ -n "$justfile" ] || exit 0

if ! command -v just >/dev/null 2>&1; then
  printf '%s\n' "pre-push: $justfile present but 'just' is not installed; cannot run repository gate." >&2
  exit 1
fi

# Fail-closed if justfile cannot be parsed
if ! recipes="$(just --summary 2>/dev/null)"; then
  printf '%s\n' "pre-push: $justfile could not be parsed by 'just'; cannot run repository gate." >&2
  exit 1
fi

# Opt-in: repository defines a `check` recipe
if ! printf '%s\n' "$recipes" | rg -qw check; then
  exit 0
fi

printf '%s\n' "pre-push: running 'just check'..." >&2
if ! just check; then
  printf '%s\n' "pre-push: 'just check' FAILED; push blocked." >&2
  exit 1
fi
