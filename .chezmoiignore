# Repository-meta files: tracked in git for documentation, but must not be
# deployed into $HOME by chezmoi apply.
# - AGENTS.md would overwrite the pre-existing global ~/AGENTS.md (Codex).
# - README.md would create an unwanted ~/README.md.
AGENTS.md
README.md

# Local-only SSH host definitions (cloud servers/VPS): never manage or deploy.
.ssh/config.local

# Goose: OAuth token caches, secret stores, and lockfiles hold credentials and
# must never be tracked in the source state or deployed (§3.1 secrets rule).
# Only dot_config/goose/config.yaml and dot_goosehints are managed.
.config/goose/secrets.yaml
.config/goose/secrets.yaml.lock
.config/goose/chatgpt_codex
.config/goose/chatgpt_codex/**
.config/goose/gemini_oauth
.config/goose/gemini_oauth/**
.config/goose/xai_oauth
.config/goose/xai_oauth/**
