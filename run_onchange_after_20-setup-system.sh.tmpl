#!/usr/bin/env bash
# keyd: {{ include "system/keyd/default.conf" | sha256sum }}

set -euo pipefail

# -----------------------------------------------------------------------------
# Keyd keyboard remapping
# -----------------------------------------------------------------------------

if ! command -v keyd >/dev/null 2>&1; then
  sudo pacman -S --needed --noconfirm keyd
fi

sudo mkdir -p /etc/keyd
sudo cp "{{ joinPath .chezmoi.sourceDir "system/keyd/default.conf" }}" /etc/keyd/default.conf
sudo systemctl enable --now keyd
sudo systemctl restart keyd

# -----------------------------------------------------------------------------
# UFW firewall defaults
# -----------------------------------------------------------------------------

if command -v ufw >/dev/null 2>&1; then
  sudo ufw default deny incoming
  sudo ufw default allow outgoing
  sudo ufw --force enable

  # Syncthing LAN sync ports (22000/tcp+udp sync+QUIC, 21027/udp discovery).
  # Idempotent: re-adding an identical rule is a no-op, so N runs == 1 run.
  # The web UI (8384) stays bound to localhost and is deliberately not opened.
  for rule in 22000/tcp 22000/udp 21027/udp; do
    sudo ufw allow "$rule" || echo ":: Warning: ufw allow $rule failed"
  done
fi

# -----------------------------------------------------------------------------
# System maintenance timers
# -----------------------------------------------------------------------------

sudo systemctl enable --now fstrim.timer paccache.timer 2>/dev/null || true

# Keep user services (e.g. syncthing.service) alive across logout/reboot
# without an interactive login. Idempotent: re-enabling is a no-op.
sudo loginctl enable-linger "$(id -un)" 2>/dev/null || true

# -----------------------------------------------------------------------------
# Background daemons
# -----------------------------------------------------------------------------

# Clash Verge proxy service (idempotent install + enable/start)
if [ -x /usr/bin/clash-verge-service-install ]; then
  if [ ! -f /etc/systemd/system/clash-verge-service.service ]; then
    sudo /usr/bin/clash-verge-service-install
  fi
  systemctl is-active --quiet clash-verge-service \
    || sudo systemctl enable --now clash-verge-service
fi

# -----------------------------------------------------------------------------
# User-level agent rules symlink
# -----------------------------------------------------------------------------

# ~/.AGENTS.md is deployed by chezmoi (dot_AGENTS.md); also expose it as
# ~/AGENTS.md so agents resolve the global rules from either path. Skip if
# anything (file or symlink) already occupies the path — strictly idempotent,
# no sudo required.
if [ ! -e "$HOME/AGENTS.md" ] && [ ! -L "$HOME/AGENTS.md" ]; then
  ln -s .AGENTS.md "$HOME/AGENTS.md"
fi
